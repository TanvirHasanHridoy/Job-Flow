{
  "manifest_version": 3,
  "name": "JobFlow AI - Application Assistant",
  "version": "1.0.0",
  "description": "Parse job descriptions from LinkedIn, StepStone, Indeed, and Xing, and tailor CVs & cover letters with JobFlow AI.",
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "cookies"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open JobFlow AI",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/*",
        "*://*.stepstone.de/*",
        "*://*.stepstone.*/*",
        "*://*.indeed.com/*",
        "*://*.indeed.de/*",
        "*://*.xing.com/*",
        "<all_urls>"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
